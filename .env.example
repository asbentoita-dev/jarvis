# 🔑 Chaves de APIs externas do Jarvis
# Copie este arquivo como ".env" e preencha. NUNCA compartilhe o .env.

# Supabase: painel do projeto > Settings > API
# URL do projeto (ex: https://abcdefgh.supabase.co)
SUPABASE_URL=
# use a chave "service_role" (acesso total) ou "anon" (limitada)
SUPABASE_KEY=

# Vercel: https://vercel.com/account/tokens > Create Token
VERCEL_TOKEN=

# Consultoria na nuvem (Claude): https://console.anthropic.com > API Keys
# Paga por uso (centavos por consulta). O Jarvis só usa quando a tarefa
# exige alta qualidade (textos científicos, análises complexas).
ANTHROPIC_API_KEY=
# opcional: modelo da nuvem (padrão: claude-sonnet-5)
# NUVEM_MODELO=claude-haiku-4-5-20251001  (mais barato)

# Tavily (busca de alta qualidade para IAs, ~1000 buscasFREE/mês):
# pegue a chave em https://app.tavily.com/home
TAVILY_API_KEY=

# Groq (cérebro de nuvem veloz, tem plano free): https://console.groq.com/keys
GROQ_API_KEY=
# opcional: modelos Groq no seletor, separados por vírgula
# GROQ_MODELOS=llama-3.3-70b-versatile,qwen-2.5-32b

# 9router (roteador próprio/local de várias IAs, API compatível com OpenAI):
# preencha a URL completa do endpoint de chat, com a porta certa.
# ROUTER_URL=http://localhost:9000/v1/chat/completions
ROUTER_URL=
ROUTER_API_KEY=
# modelos disponíveis no 9router, separados por vírgula (nomes que ele aceita)
# ROUTER_MODELOS=gpt-4o-mini,claude-3-5-sonnet,gemini-1.5-pro
ROUTER_MODELOS=

# ── Ollama (modelo local) ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# modelo local padrão do Jarvis (deve suportar function calling):
# llama3.1, llama3.2, qwen2.5, mistral-nemo, etc.
# llama3 NÃO suporta tools.
JARVIS_MODELO=llama3.1

# ── LM Studio (modelo local alternativo) ────────────────────────────
LMSTUDIO_URL=http://localhost:1234

# ── KoboldCpp (motor local com aceleração Vulkan — suporta AMD) ────
KOBOLDCPP_URL=http://localhost:5001
# build Vulkan (não CUDA): koboldcpp-nocuda.exe
KOBOLDCPP_EXE=C:\Users\koboldcpp-nocuda.exe
KOBOLDCPP_PORT=5001

# backend local ativo: "ollama", "lmstudio" ou "koboldcpp"
SERVIDOR_LOCAL=ollama

# ── FFmpeg (extrai frame de vídeo anexado no chat) ─────────────────
FFMPEG_PATH=
# liga/desliga processamento de vídeo (0 = desligado)
VIDEO_ATIVO=1

# ── Stable Diffusion (SD-API, geração de imagens) ──────────────────
SD_API_URL=http://localhost:8200
# liga/desliga imagens automáticas (0 = desligado)
IMAGENS_AUTO=1

# ── Comportamento do Jarvis ────────────────────────────────────────
# modelo automático: troca sozinho de modelo LOCAL conforme o pedido
# (0 = desligado, 1 = ligado)
AUTO_MODELO_ATIVO=1
# linha de produção: classifica a tarefa e roteia pro fluxo certo
# (0 = desligado, 1 = ligado)
LINHA_PRODUCAO_ATIVO=1

# ── Timeouts ────────────────────────────────────────────────────────
# timeout para chamadas de nuvem (segundos)
TIMEOUT_RESPOSTA=120
# timeout para chamadas locais (segundos) — maior, pois modelos locais
# podem demorar mais na carga inicial sem que nada esteja quebrado
TIMEOUT_RESPOSTA_LOCAL=600